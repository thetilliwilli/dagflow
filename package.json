{
  "name": "dagflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:e2e": "playwright test --project chromium",
    "test:perf": "playwright test --project perf",
    "test:e2e:firefox": "playwright test --project firefox",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/engine/tsconfig.json --noEmit && tsc -p packages/protocol/tsconfig.json --noEmit && tsc -p packages/server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "build:server": "vite build --config packages/server/vite.config.ts",
    "server": "npm run build:server && node packages/server/dist/dagflow-server.mjs",
    "test:conformance": "npm run build:server && vitest run --project conformance",
    "server:bun": "npm run build:server && bun packages/server/dist/dagflow-server.mjs",
    "server:deno": "npm run build:server && deno run --allow-net packages/server/dist/dagflow-server.mjs",
    "test:e2e:bundle": "playwright test -c playwright.bundle.config.ts"
  },
  "dependencies": {
    "@dagflow/engine": "*",
    "@dagflow/protocol": "*",
    "@xyflow/react": "^12.12.0",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
